# Copy to backend/.env (git-ignored) for local development with the dev profile:
#   cp .env.example .env
# Never commit a filled-in copy of this file. Real environment variables override these values.
#
# This file is read only when the dev profile is active, so it cannot select the profile itself.
# Start the app with: ./mvnw spring-boot:run -Dspring-boot.run.profiles=dev

# --- Server ---
PORT=8080

# --- Database (matches docker-compose.yml) ---
DB_URL=jdbc:postgresql://localhost:5432/vams_db
DB_USERNAME=postgres
DB_PASSWORD=admin
# Hibernate schema check. Flyway applies the migrations; keep this on validate
DDL_AUTO=validate

# --- JWT (required) ---
# Base64 HMAC key, at least 32 bytes decoded. Generate one: openssl rand -base64 48
JWT_SECRET=
# Access-token lifetime in ms (1800000 = 30 minutes)
JWT_EXPIRATION_MS=1800000
# Refresh-token lifetime in ms (2592000000 = 30 days), counted from login: rotation does not extend it
REFRESH_TOKEN_EXPIRATION_MS=2592000000
# A spent refresh token reused within this window (ms) is treated as a client retry; after it,
# reuse revokes every active refresh token of that user (theft detection)
REFRESH_TOKEN_REUSE_GRACE_MS=5000
# Daily purge of refresh tokens that have been revoked or expired for longer than the retention period
REFRESH_TOKEN_CLEANUP_CRON=0 30 3 * * *
REFRESH_TOKEN_CLEANUP_RETENTION_DAYS=7

# --- Bootstrap admin ---
# Created on startup if the email does not exist yet; an existing account's password is never changed.
# Leave ADMIN_EMAIL empty to skip. ADMIN_PASSWORD needs 12+ characters.
ADMIN_EMAIL=admin@vams.local
ADMIN_PASSWORD=
ADMIN_FULL_NAME=System Administrator

# --- Pricing ---
# GST percent for accessories that have no tax rate of their own
DEFAULT_TAX_RATE=18.00

# --- Customer garage ---
MAX_VEHICLES_PER_CUSTOMER=10

# --- Inventory analysis ---
# Spring cron (sec min hour day month weekday) for the daily stock report and low-stock warnings
INVENTORY_ANALYSIS_CRON=0 0 0 * * *
INVENTORY_ANALYSIS_TIME_ZONE=UTC

# --- Demo data (dev profile only) ---
# true fills an EMPTY database with a demo catalog, discounts, stock history and a demo customer
# (demo.customer@vams.local) who has two vehicles. Skipped when accessories already exist.
DEMO_SEED=false
# Password for the demo customer, 12+ characters
DEMO_CUSTOMER_PASSWORD=
